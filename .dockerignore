# ============================================
# DOCKER IGNORE FILE
# Exclude files from Docker build context
# ============================================

# ============================================
# PYTHON / BACKEND
# ============================================
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/pip-log.txt
**/pip-delete-this-directory.txt
**/.pytest_cache
**/.coverage
**/htmlcov
**/.tox
**/.mypy_cache
**/.dmypy.json
**/dmypy.json

# Virtual environments
venv/
venv311/
env/
ENV/
.venv/

# ============================================
# NODE.JS / FRONTEND
# ============================================
**/node_modules
**/.next
**/out
**/build
**/.cache
**/dist

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ============================================
# IDE / EDITOR
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# GIT
# ============================================
.git/
.gitignore
.gitattributes

# ============================================
# DOCKER
# ============================================
Dockerfile
docker-compose.yml
.dockerignore

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key

# ============================================
# DOCUMENTATION
# ============================================
README.md
docs/
*.md

# ============================================
# DATA & UPLOADS (keep out of images)
# ============================================
data/
uploads/
outputs/
*.mp4
*.mp3
*.wav
*.avi
*.mov

# ============================================
# TEMPORARY FILES
# ============================================
tmp/
temp/
*.tmp
*.log
