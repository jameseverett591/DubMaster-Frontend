# ============================================
# DUBVERSE BACKEND DOCKERFILE — GPU SERVERLESS
# CUDA 12.1 + cuDNN 8 + Python 3.11
# For RunPod Serverless Endpoints
#
# LEAN IMAGE — models download at runtime via
# _warm_models() in handler.py, NOT at build time.
# Target size: ~4-6GB (down from 16GB+)
# ============================================

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;12.0"

WORKDIR /app

# ============================================
# SYSTEM DEPENDENCIES
# ============================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    ffmpeg \
    librubberband2 \
    libsndfile1 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    python3 -m pip install --upgrade pip

# ============================================
# PYTHON DEPENDENCIES
# ============================================
COPY requirements.gpu.txt .

RUN pip install --no-cache-dir -r requirements.gpu.txt && \
    pip install --no-cache-dir runpod>=1.6.0

# ============================================
# APPLICATION
# ============================================
COPY ./app /app/app
COPY handler.py /app/handler.py

RUN mkdir -p /app/data/uploads /app/data/separated /app/data/transcripts \
    /app/data/diarization /app/data/chunks /app/data/processed /app/data/output \
    /app/uploads /app/outputs /app/logs

# ============================================
# NO MODEL PRE-CACHING
# Models are downloaded at runtime by _warm_models()
# in handler.py on first container start. This keeps
# the image small (~4-6GB) for fast RunPod pulls.
# ============================================

# HF_TOKEN passed as env var at runtime (not build arg)
# for pyannote model access

# ============================================
# ENTRYPOINT — RunPod Serverless Handler
# ============================================
CMD ["python", "-u", "handler.py"]
