# ============================================
# DUBVERSE BACKEND DOCKERFILE — GPU (CUDA)
# CUDA 11.8 + cuDNN 8 + Python 3.11
# For RunPod / AWS g4dn / any NVIDIA GPU host
# ============================================

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# ============================================
# SYSTEM DEPENDENCIES
# ============================================
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    ffmpeg \
    build-essential \
    libsndfile1 \
    libsndfile1-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    python3 -m pip install --upgrade pip

# ============================================
# PYTHON DEPENDENCIES
# ============================================
COPY requirements.gpu.txt .

RUN pip install --no-cache-dir -r requirements.gpu.txt

# ============================================
# VERIFY GPU STACK
# ============================================
RUN python -c "import torch; assert torch.cuda.is_available(), 'CUDA not available'; print(f'PyTorch {torch.__version__} CUDA {torch.version.cuda}')" && \
    python -c "import fastapi; print(f'FastAPI {fastapi.__version__}')" && \
    python -c "import edge_tts; print('Edge TTS OK')" && \
    echo "All GPU dependencies verified"

# ============================================
# APPLICATION
# ============================================
COPY ./app /app/app

RUN mkdir -p /app/data /app/uploads /app/outputs /app/logs

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
