# ============================================
# DUBVERSE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ============================================

# ============================================
# API KEYS
# ============================================

# ElevenLabs TTS API Key
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# DeepL Translation API Key
# Get from: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_key_here

# Hugging Face Token (for pyannote.audio models)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_huggingface_token_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE_MB=500

# Maximum video duration (in seconds)
# 2 hours = 7200 seconds
MAX_VIDEO_DURATION_SECONDS=7200

# Number of workers for uvicorn (production only)
UVICORN_WORKERS=4

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API URL (for frontend to reach backend)
# Development: http://backend:8000 (inside Docker network)
# Production: https://api.dubverse.com
NEXT_PUBLIC_API_URL=http://backend:8000

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=your_ga_id_here

# ============================================
# OPTIONAL: DATABASE (for future use)
# ============================================

# PostgreSQL connection (if you add a database later)
# DATABASE_URL=postgresql://user:password@localhost:5432/dubverse

# Redis connection (for job queues/caching)
# REDIS_URL=redis://localhost:6379/0
