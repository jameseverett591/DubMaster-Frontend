# ============================================
# DUBVERSE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ============================================

# ============================================
# API KEYS
# ============================================

# ElevenLabs TTS API Key
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Fish Audio TTS API Key (voice cloning + emotion tags)
# Get from: https://fish.audio/app/api-keys/
# FISH_AUDIO_API_KEY=your_fish_audio_key_here

# TTS Provider Selection: "elevenlabs" (default) or "fish-audio"
# TTS_PROVIDER=elevenlabs

# Fish Audio Voice Model IDs (set after uploading actor voice samples)
# Upload clips at fish.audio, then copy the reference_id here
# FISH_VOICE_MALE_1=reference_id_here
# FISH_VOICE_MALE_2=reference_id_here
# FISH_VOICE_FEMALE_1=reference_id_here
# FISH_VOICE_CHILD_1=reference_id_here

# DeepL Translation API Key
# Get from: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_key_here

# Hugging Face Token (for pyannote.audio models)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_huggingface_token_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE_MB=500

# Maximum video duration (in seconds)
# 2 hours = 7200 seconds
MAX_VIDEO_DURATION_SECONDS=7200

# Number of workers for uvicorn (production only)
UVICORN_WORKERS=4

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API URL (for frontend to reach backend)
# Development: http://backend:8000 (inside Docker network)
# Production: https://api.dubverse.com
NEXT_PUBLIC_API_URL=http://backend:8000

# ============================================
# VOZO AI (Full-pipeline cloud dubbing)
# ============================================

# Vozo AI API Key
# Get from: https://vozo.ai/
# VOZO_API_KEY=your_vozo_api_key_here

# Enable Vozo as a dubbing engine option (requires PUBLIC_BASE_URL)
# VOZO_ENABLED=true

# Public base URL for serving media to external APIs (Vozo, Sync.Labs)
# Must be accessible from the internet (use ngrok for development)
# PUBLIC_BASE_URL=https://your-server.com

# Lip-sync provider: "synclabs" (default), "vozo", or "none"
# LIPSYNC_PROVIDER=synclabs

# ============================================
# OPTIONAL: QUALITY ANALYSIS AI SERVICES
# ============================================

# Hume AI (emotion/prosody analysis of dubbed audio)
# Get from: https://platform.hume.ai/
# HUME_API_KEY=your_hume_api_key_here

# Azure Speech (pronunciation assessment)
# Get from: https://portal.azure.com/ -> Cognitive Services -> Speech
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=eastus

# Azure OpenAI (translation quality evaluation via GPT-4)
# Get from: https://portal.azure.com/ -> Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your_azure_openai_key_here
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# ScreenApp (AI video analysis for dub quality checks)
# Get from: https://screenapp.io/app/#/settings/plugin
# SCREENAPP_API_KEY=your_screenapp_api_token_here
# SCREENAPP_TEAM_ID=your_screenapp_team_id_here
# SCREENAPP_FOLDER_ID=your_screenapp_folder_id_here

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=your_ga_id_here

# ============================================
# OPTIONAL: DATABASE (for future use)
# ============================================

# PostgreSQL connection (if you add a database later)
# DATABASE_URL=postgresql://user:password@localhost:5432/dubverse

# Redis connection (for job queues/caching)
# REDIS_URL=redis://localhost:6379/0
