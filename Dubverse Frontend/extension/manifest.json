{
  "manifest_version": 3,
  "name": "DubMaster Import",
  "version": "1.0.0",
  "description": "Send the YouTube video you're watching to DubMaster Studio for AI dubbing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "Import this video to DubMaster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
